parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$array \(array\{non\-falsy\-string\}\) to function array_filter does not contain falsy values, the array will always stay the same\.$#'
			identifier: arrayFilter.same
			count: 1
			path: Api.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Call to an undefined method Omnifood\\PlatformInterface\:\:api\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Cannot call method request\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Method Omnifood\\Zenchef\\Tests\\ZenchefPlatformTest\:\:platform\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Method Omnifood\\Zenchef\\Tests\\ZenchefPlatformTest\:\:platform\(\) should return Omnifood\\Zenchef\\ZenchefPlatform but returns Omnifood\\PlatformInterface\.$#'
			identifier: return.type
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnifood\\PlatformFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Parameter \#2 \$string of function explode expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/ZenchefPlatformTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: ZenchefPlatformFactory.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''strval'' given\.$#'
			identifier: argument.type
			count: 1
			path: ZenchefPlatformFactory.php

		-
			message: '#^Parameter \#4 \$headers of class Omnifood\\Zenchef\\Api constructor expects array\<string, string\>, array\<string\> given\.$#'
			identifier: argument.type
			count: 1
			path: ZenchefPlatformFactory.php
