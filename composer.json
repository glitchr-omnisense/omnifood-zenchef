{
    "name": "omnifood/zenchef",
    "type": "library",
    "description": "Omnifood Zenchef: the restaurant's credentials and a client ready for Zenchef's partner API, whose documentation Zenchef sends on request - every reservation call refused until it is public.",
    "keywords": ["restaurant", "reservations", "booking", "zenchef", "omnifood"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omnisense/omnifood": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnifood\\Zenchef\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnifood\\Zenchef\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
